{
"scripts": {
"build:js": "echo 'Budowanie JS...'",
"build:css": "echo 'Budowanie CSS...'",
"build:assets": "echo 'Kopiowanie plików...'",
"build": "npm-run-all build:sass build:autoprefixer build:js build:css build:assets",
"build:autoprefixer": "postcss css/*.css --use autoprefixer -d css",
"build:sass": "sass --style=compressed --no-source-map sass:css",
"build:dev-sass": "sass --style=expanded --source-map sass:css",
"build:dev": "npm run build:dev-sass && sass --style=expanded --source-map sass:css",
"watch:sass": "sass --watch --style=expanded --source-map sass:css",
"watch:sassprefixer": "sass/*.scss -- npm run build-dev",
"watch:sass": "sass --watch --style=expanded --source-map sass:css",
"watch": "npm-run-all -p watch:sass",
"init-project": "npm install && npm-run-all init:*",
"init:dirs": "mkdirp sass css vendor images js",
"init:files": "touch Readme.md index.html sass/style.scss js/script.js",
"init:gitignore": "curl https://raw.githubusercontent.com/github/gitignore/master/Node.gitignore -o .gitignore",
"test": "npm run test:html",
"test:html": "html-validate *.html"
},
"repository": {
"type": "git",
"url": "git+https://github.com/Mdev122/GitKodiTut.git"
},
"bugs": {
"url": "https://github.com/Mdev122/GitKodiTut/issues"
},
"homepage": "https://github.com/Mdev122/GitKodiTut#readme",
"keywords": [],
"author": "",
"license": "ISC",
"type": "commonjs",
"dependencies": {
"npm-run-all": "^4.1.5",
"sass": "^1.99.0"
},
"devDependencies": {
"autoprefixer": "^10.2.4",
"html-validate": "^11.2.0",
"mkdirp": "^3.0.1",
"postcss": "^8.2.6",
"postcss-cli": "^8.3.1"
}
}